{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zandor",
  "version": "../package.json",
  "identifier": "id.web.zandor.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun ../../scripts/prepare-engine.ts --plugin && bun run dev",
    "beforeBuildCommand": "bun ../../scripts/prepare-engine.ts --plugin && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zandor",
        "width": 1366,
        "height": 768,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "shadow": true,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'self' about: zpreview: http://zpreview.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/opencode"],
    "resources": ["resources/zandor-plugin.js"]
  }
}
