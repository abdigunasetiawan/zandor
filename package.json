{
  "name": "zandor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "e2e": "bun run --filter @zandor/desktop e2e",
    "licenses": "bun scripts/license-audit.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run licenses",
    "dev": "bun run --filter @zandor/desktop tauri dev",
    "build:desktop": "bun run --filter @zandor/desktop tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
