{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zandor-spike-s1",
  "version": "0.0.0",
  "identifier": "id.web.zandor.spike.s1",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Zandor Spike S1 — sidecar opencode", "width": 900, "height": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/opencode"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
